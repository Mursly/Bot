# ===========================================================================
#  ⚠️  NE REMPLISSEZ PAS CE FICHIER  ⚠️
#
#  Ce fichier est un MODÈLE, et il est SUIVI PAR GIT.
#  Une clé écrite ici finirait dans un commit, puis sur GitHub.
#
#  Faites plutôt :
#      cp .env.example .env
#  puis remplissez « .env », qui est ignoré par git.
#
#  Les deux fichiers se ressemblent : vérifiez le nom dans votre éditeur
#  avant de coller quoi que ce soit. Si vous voyez « .example », arrêtez-vous.
#
#  Une clé collée ici par erreur doit être RÉVOQUÉE, pas seulement effacée :
#  l'historique git la conserve.
# ===========================================================================

# === Discord (obligatoire) ===
# Onglet « Bot » du portail développeur Discord -> Reset Token.
DISCORD_TOKEN=
# Onglet « General Information » -> Application ID.
DISCORD_CLIENT_ID=
# Facultatif : ID d'un serveur de test. Si renseigné, les commandes slash y sont
# publiées instantanément au lieu d'attendre la propagation globale (jusqu'à 1 h).
DISCORD_GUILD_ID=

# === Riot Games (obligatoire) ===
# https://developer.riotgames.com/ -> « Development API Key » (à régénérer
# toutes les 24 h) ou clé Personal/Production une fois votre projet validé.
RIOT_API_KEY=

# === Anthropic (facultatif) ===
# Sans clé, Ezreal bascule automatiquement sur l'analyse par règles.
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Modèle utilisé pour rédiger l'analyse.
ANTHROPIC_MODEL=claude-sonnet-4-5
# Longueur maximale de la réponse du modèle, en tokens.
ANTHROPIC_MAX_TOKENS=700

# === Réglages du service (facultatif, valeurs par défaut indiquées) ===
# Intervalle entre deux vérifications de nouvelles parties, en secondes.
# Minimum 30 s, recommandé 60-120 s pour rester dans les limites de l'API Riot.
POLL_INTERVAL_SECONDS=90
# Chemin du fichier SQLite.
DATABASE_PATH=./data/ezreal.sqlite
# debug | info | warn | error
LOG_LEVEL=info
# Région proposée par défaut dans /suivre.
DEFAULT_PLATFORM=euw1
